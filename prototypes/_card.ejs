<%
// Prototype cards. The first (newest) item leads wide; the rest run two-up.
// Reads these optional front-matter keys per prototype:
//   kind    — "Live app", "Research tool", …
//   status  — e.g. "Working · not maintained"
//   demo    — URL of the running thing
//   source  — URL of the repository
//
// The whole body is emitted inside a ```{=html}``` raw block: a custom listing
// template's output is parsed by Pandoc as Markdown, and any 4-space-indented
// HTML would otherwise be shown as a literal code block. The raw block also
// makes indentation and blank lines harmless, so this stays readable.
// `href` runs through a backslash->slash swap because item.path uses the OS
// separator, which is a backslash on Windows and breaks the URL.
const href = (p) => (p || "").replace(/\\/g, "/");
%>
```{=html}
<div class="proto-list">
<% for (const [i, item] of items.entries()) { %>
  <article class="proto-card<%= i === 0 ? ' proto-lead' : '' %>">
    <% if (item.image) { %>
    <a class="proto-thumb" href="<%= href(item.path) %>"><img src="<%= item.image %>" alt="<%= item['image-alt'] || item.title %>" loading="<%= i === 0 ? 'eager' : 'lazy' %>" decoding="async"<%- i === 0 ? ' fetchpriority="high"' : '' %>></a>
    <% } %>
    <div class="proto-body">
      <div class="proto-eyebrow"><% if (item.kind) { %><span class="proto-kind"><%= item.kind %></span><span class="proto-dash"></span><% } %><% if (item.date) { %><span class="proto-date"><%= item.date %></span><% } %></div>
      <h3 class="proto-title"><a href="<%= href(item.path) %>"><%= item.title %></a></h3>
      <% if (item.description) { %><p class="proto-desc"><%= item.description %></p><% } %>
      <div class="proto-foot"><span class="proto-status"><%= item.status || "" %></span><div class="proto-actions"><% if (item.demo) { %><a class="proto-btn" href="<%= item.demo %>" target="_blank" rel="noopener">Live demo</a><% } %><% if (item.source) { %><a class="proto-btn" href="<%= item.source %>" target="_blank" rel="noopener">Source</a><% } %><a class="proto-btn proto-btn-read" href="<%= href(item.path) %>">Write-up</a></div></div>
      <% if (item.categories) { %><div class="proto-cats"><% for (const c of item.categories) { %><span class="proto-cat"><%= c %></span><% } %></div><% } %>
    </div>
  </article>
<% } %>
</div>
```
